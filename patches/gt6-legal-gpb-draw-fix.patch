+/* Formats the legacy generic textured path can sample: the GPB/UI image classes
+ * (A8R8G8B8 and DXT1/23/45). B8 (0x81) is the dbgfont atlas and keeps its own
+ * coverage PS; G8B8 (0x8B) is LBP's font atlas, not a colour image. */
+static int legacy_generic_tex_format(u32 fmt)
+{
+    const u32 bf = fmt & 0x9F;
+    return bf == 0x85 || (bf >= 0x86 && bf <= 0x88);
+}
+
+static DXGI_FORMAT legacy_generic_tex_dxgi(u32 fmt)
+{
+    switch (fmt & 0x9F) {
+    case 0x85: return DXGI_FORMAT_R8G8B8A8_UNORM;
+    case 0x86: return DXGI_FORMAT_BC1_UNORM;
+    case 0x87: return DXGI_FORMAT_BC2_UNORM;
+    case 0x88: return DXGI_FORMAT_BC3_UNORM;
+    default:   return DXGI_FORMAT_UNKNOWN;
+    }
+}
+
+/* A no-VP draw with a generic guest image bound. The B8 atlas path is excluded:
+ * it has its own PSO, SRV slot and UV convention. */
+static int legacy_generic_tex_bound(void)
+{
+    if (s_d3d.tex_bound) return 0;
+    if (!s_d3d.cur_texs[0].set || !s_d3d.cur_texs[0].off) return 0;
+    return legacy_generic_tex_format(s_d3d.cur_texs[0].fmt);
+}
