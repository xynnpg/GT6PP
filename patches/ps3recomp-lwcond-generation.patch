 }
+enum { LWC_GEN_TAB = 4096 };
+static std::atomic<uint32_t> s_lwc_gen[LWC_GEN_TAB];
+static std::atomic<uint32_t>* lwc_gen(uint32_t lwcond)
+{
+    if (!lwcond) return nullptr;
+    const uint32_t qid = vm_read32((uint64_t)lwcond + 4u);
+    return (qid & 0xFF000000u) == 0x4C000000u
+        ? &s_lwc_gen[qid & (LWC_GEN_TAB - 1)] : nullptr;
+}
+static int lwc_sleep_mode(void)
+{
+    static int m = -1;
+    if (m < 0) { const char* e = getenv("PS3_LWCOND_SLEEP"); m = (e && *e && *e != '0') ? 1 : 0; }
+    return m;
+}
+static uint32_t lwc_poll_us(void)
+{
+    static uint32_t v = 0;
+    if (!v) {
+        const char* e = getenv("PS3_LWCOND_POLL_MS");
+        v = (e && atoi(e) > 0 ? (uint32_t)atoi(e) : 1u) * 1000u;
+    }
+    return v;
+}
+static void lwc_wait(std::atomic<uint32_t>* g, uint32_t seen, uint32_t max_us)
+{
+    /* LLVM-MinGW does not export WaitOnAddress/WakeByAddressAll, so poll the
+     * generation.  The wait is capped at 1 ms by default; the guest's
+     * predicate loop re-checks either way. */
+    LARGE_INTEGER freq, start, now;
+    QueryPerformanceFrequency(&freq);
+    QueryPerformanceCounter(&start);
+    unsigned spins = 0;
+    while (g->load(std::memory_order_acquire) == seen) {
+        if (max_us) {
+            QueryPerformanceCounter(&now);
+            if ((uint64_t)(now.QuadPart - start.QuadPart) * 1000000ull /
+                    (uint64_t)freq.QuadPart >= max_us)
+                break;
+        }
+        if (++spins < 64) YieldProcessor();
+        else Sleep(0);
+    }
+}
+static void lwc_wake(ppu_context* ctx, int all)
+{
+    uint32_t lwcond = (uint32_t)ctx->gpr[3];
+    uint32_t qid = lwcond ? vm_read32((uint64_t)lwcond + 4u) : 0;
+    std::atomic<uint32_t>* g = lwc_gen(lwcond);
+    if (!g) {
+        if (lwc_trace()) {
+            static volatile long n = 0;
+            if (InterlockedIncrement(&n) <= 400)
+                fprintf(stderr, "[LWCOND] signal%s tid=%llu lwcond=0x%08X qid=0x%08X gen=unkeyed lr=0x%08X\n",
+                        all ? "_all" : "", (unsigned long long)ctx->thread_id, lwcond, qid,
+                        (unsigned)ctx->lr);
+        }
+        return;
+    }
+    g->fetch_add(1, std::memory_order_release);
+    if (lwc_trace()) {
+        static volatile long n = 0;
+        if (InterlockedIncrement(&n) <= 400)
+            fprintf(stderr, "[LWCOND] signal%s tid=%llu lwcond=0x%08X qid=0x%08X gen=%u lr=0x%08X\n",
+                    all ? "_all" : "", (unsigned long long)ctx->thread_id, lwcond, qid,
+                    g->load(std::memory_order_relaxed), (unsigned)ctx->lr);
+    }
+    /* Waiters poll the generation; no Win32 wait-address API needed. */
+}
