+/* Real lwcond wake channel keyed by the lwcond EA. A waiter registers
+ * (waiters++) before it drops the lwmutex, so a signal sent after that is
+ * never lost. The poll-style wait (Sleep(1), return) wakes spuriously, and
+ * GT6's event wrapper (0xA21CBC / 0xA21D8C) waits once without re-checking:
+ * the caller then leaves a file request that lives on its stack while the
+ * file worker still uses it. PS3_LWCOND_POLL=1 restores the poll wait. */
+#define LWC_HASH 1024
+struct LwcSlot { volatile long key; volatile long addr; HANDLE sem; volatile long waiters; volatile long pending; };
+static struct LwcSlot g_lwc[LWC_HASH];
+static volatile long g_lwc_tab_lock = 0;
+static int lwc_poll_mode(void)
+{
+    static int m = -1;
+    if (m < 0) { const char* e = getenv("PS3_LWCOND_POLL"); m = (e && *e && *e != '0') ? 1 : 0; }
+    return m;
+}
+static int lwc_trace(void)
+{
+    static int m = -1;
+    if (m < 0) { const char* e = getenv("PS3_LWCOND_TRACE"); m = (e && *e && *e != '0') ? 1 : 0; }
+    return m;
+}
+static struct LwcSlot* lwc_slot(uint32_t addr)
+{
+    if (!addr) return nullptr;
+    /* PS3 lwcond is identified by the queue id at +4, not by the address:
+     * the guest copies the 8-byte lwcond (0xA21D50 wrappers) and both the
+     * waiter and the signaler must resolve to the same object.  Keying by
+     * address split them and lost the file-worker completion wake. */
+    uint32_t qid = vm_read32((uint64_t)addr + 4u);
+    uint32_t key = qid ? qid : addr;
+    uint32_t h = (key * 2654435761u) & (LWC_HASH - 1);
+    for (uint32_t i = 0; i < LWC_HASH; i++) {
+        uint32_t idx = (h + i) & (LWC_HASH - 1);
+        long cur = g_lwc[idx].key;
+        if ((uint32_t)cur == key) return &g_lwc[idx];
+        if (cur == 0) {
+            while (_InterlockedExchange(&g_lwc_tab_lock, 1)) YieldProcessor();
+            struct LwcSlot* r = nullptr;
+            if (g_lwc[idx].key == 0) {
+                g_lwc[idx].sem = CreateSemaphoreA(NULL, 0, 0x7FFFFFFF, NULL);
+                g_lwc[idx].waiters = 0;
+                g_lwc[idx].pending = 0;
+                g_lwc[idx].addr = (long)addr;
+                g_lwc[idx].key = (long)key;
+                r = &g_lwc[idx];
+            } else if ((uint32_t)g_lwc[idx].key == key) {
+                r = &g_lwc[idx];
+            }
+            _InterlockedExchange(&g_lwc_tab_lock, 0);
+            if (r) return r;
+        }
+    }
+    return nullptr;
+}
+static void lwc_wake(ppu_context* ctx, int all)
+{
+    uint32_t lwcond = (uint32_t)ctx->gpr[3];
+    uint32_t qid = lwcond ? vm_read32((uint64_t)lwcond + 4u) : 0;
+    struct LwcSlot* c = lwc_slot(lwcond);
+    long w = c ? c->waiters : -1;
+    if (lwc_trace()) {
+        static volatile long n = 0;
+        if (InterlockedIncrement(&n) <= 400)
+            fprintf(stderr, "[LWCOND] signal%s tid=%llu lwcond=0x%08X qid=0x%08X waiters=%ld pending=%ld lr=0x%08X\n",
+                    all ? "_all" : "", (unsigned long long)ctx->thread_id, lwcond, qid, w,
+                    c ? c->pending : -1, (unsigned)ctx->lr);
+    }
+    if (!c) return;
+    for (;;) {
+        w = c->waiters;
+        if (w <= 0) {
+            /* A signal that arrives before the waiter registers must not be
+             * lost: PS3 lwcond keeps it pending for the next wait. */
+            if (all) c->pending = 1;
+            else InterlockedIncrement(&c->pending);
+            return;
+        }
+        long take = all ? w : 1;
+        if (InterlockedCompareExchange(&c->waiters, w - take, w) == w) {
+            ReleaseSemaphore(c->sem, take, NULL);
+            return;
+        }
+    }
+}
