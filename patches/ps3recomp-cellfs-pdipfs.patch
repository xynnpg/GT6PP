+    guest_strcpy(gpath, (uint32_t)ctx->gpr[3], sizeof gpath);
+    host_path(hpath, sizeof hpath, gpath);
+    int r = remove(hpath);
+    int err = errno;
+    if (pfs_cache_trace() && fs_is_cache_path(gpath))
+        fprintf(stderr, "[pfscache] unlink '%s' -> %s lr=0x%08X\n",
+                gpath, r == 0 ? "OK" : strerror(err), (uint32_t)ctx->lr);
+    /* Deleting a file that is already gone is what the guest's cache cleanup
+     * expects.  Windows also refuses to remove a file that another handle has
+     * open (EACCES/EBUSY); PS3 cellFs unlink can succeed there, and the cache
+     * cleanup treats failure as fatal, so report success and leave the file for
+     * the completion rename / next boot. */
+    ctx->gpr[3] = (r == 0 || err == ENOENT || err == EACCES || err == EBUSY)
+                      ? CELL_OK : (uint64_t)(int64_t)CELL_FS_EIO;
+}
