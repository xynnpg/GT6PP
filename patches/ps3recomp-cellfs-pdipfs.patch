+/* cellFsRename(from, to): the PDIPFS completion marker.  0xA3F6B4 uses this to
+ * turn "<key>.fdupi" into "<key>" after every block is present; a no-op here
+ * leaves the cache permanently "incomplete" and the next boot rebuilds it. */
+static void cellFsRename(ppu_context* ctx)
+{
+    char gfrom[1024], gto[1024], hfrom[1100], hto[1100];
+    guest_strcpy(gfrom, (uint32_t)ctx->gpr[3], sizeof gfrom);
+    guest_strcpy(gto,   (uint32_t)ctx->gpr[4], sizeof gto);
+    host_path(hfrom, sizeof hfrom, gfrom);
+    host_path(hto,   sizeof hto,   gto);
+
+    char parent[1100];
+    fs_parent_dir(parent, sizeof parent, hto);
+    if (parent[0]) host_mkdir_p(parent);
+
+    /* POSIX rename replaces the destination; the Windows CRT rename refuses to
+     * when it exists.  A completed cache from an older run is exactly that
+     * case, so remove the stale destination first. */
+    struct stat st;
+    if (stat(hto, &st) == 0) remove(hto);
+    int r = rename(hfrom, hto);
+    int err = errno;
+    if (pfs_cache_trace() && (fs_is_cache_path(gfrom) || fs_is_cache_path(gto)))
+        fprintf(stderr, "[pfscache] rename '%s' -> '%s' %s (errno=%d) lr=0x%08X\n",
+                gfrom, gto, r == 0 ? "OK" : "FAIL", err, (uint32_t)ctx->lr);
+    ctx->gpr[3] = r == 0 ? CELL_OK : (uint64_t)(int64_t)CELL_FS_ENOENT;
+}
