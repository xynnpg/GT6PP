+/* ---- truncate / preallocate ------------------------------------------------
+ *
+ * cellFsAllocateFileAreaWithoutZeroFill(path, size) and cellFsTruncate(path,
+ * size) both size an existing (or newly created) file.  The old no-op was a
+ * fidelity bug for the PDIPFS cache: 0xA42020 opens "<key>.fdupi" with
+ * O_RDWR|O_CREAT and immediately calls 0xA420A8 -> 0xF924B0 (NID 0x7A0329A1)
+ * to size it to the stored stream length.  The cache writer itself appends at
+ * block offsets, so the no-op does not by itself explain an empty block map --
+ * but it leaves the data file the wrong length/state and it makes the HLE lie
+ * about a call that has real semantics.
+ *
+ * "Without zero fill" cannot be expressed on a normal host filesystem when a
+ * file is extended (the tail reads as zeroes anyway).  Use ftruncate/_chsize_s:
+ * existing bytes are preserved, the size is exact, and nothing is fabricated.
+ * Prefer the guest's already-open FILE* so Windows sharing does not reject the
+ * second open. */
+static void fs_parent_dir(char* out, size_t cap, const char* path)
+{
+    snprintf(out, cap, "%s", path);
+    char* slash = strrchr(out, '/');
+    char* bslash = strrchr(out, '\\');
+    char* p = bslash ? bslash : slash;
+    if (slash && (!p || slash > p)) p = slash;
+    if (p) *p = 0;
+}
+
+static FILE* fs_find_open(const char* gpath)
+{
+    for (int i = 3; i < FS_MAX; i++) {
+        FILE* f = fd_file(i);
+        if (f && strcmp(g_fd_path[i], gpath) == 0) return f;
+    }
+    return nullptr;
+}
+
+static int fs_truncate_guest_path(const char* gpath, uint64_t size)
+{
+    char hpath[1100];
+    host_path(hpath, sizeof hpath, gpath);
+
+    if (FILE* f = fs_find_open(gpath)) {
+        fflush(f);
+#ifdef _WIN32
+        if (_chsize_s(_fileno(f), (long long)size) == 0) return 0;
+#else
+        if (ftruncate(fileno(f), (off_t)size) == 0) return 0;
+#endif
+        /* The guest may hold this path read-only; fall through to a writable
+         * open rather than turning a valid path truncate into a failure. */
+    }
+
+    char parent[1100];
+    fs_parent_dir(parent, sizeof parent, hpath);
+    if (parent[0]) host_mkdir_p(parent);
+
+    int hfd = open(hpath, O_RDWR | O_CREAT | O_BINARY, 0666);
+    if (hfd < 0) return -1;
+#ifdef _WIN32
+    int rc = _chsize_s(hfd, (long long)size);
+#else
+    int rc = ftruncate(hfd, (off_t)size);
+#endif
+    close(hfd);
+    return rc == 0 ? 0 : -1;
+}
+
+static void cellFsAllocateFileAreaWithoutZeroFill(ppu_context* ctx)
+{
+    char gpath[1024];
+    guest_strcpy(gpath, (uint32_t)ctx->gpr[3], sizeof gpath);
+    uint64_t size = ctx->gpr[4];
+    int r = fs_truncate_guest_path(gpath, size);
+    int err = errno;
+    if (pfs_cache_trace() && fs_is_cache_path(gpath))
+        fprintf(stderr, "[pfscache] allocate '%s' size=0x%llX -> %s lr=0x%08X\n",
+                gpath, (unsigned long long)size, r == 0 ? "OK" : strerror(err),
+                (uint32_t)ctx->lr);
+    ctx->gpr[3] = r == 0 ? CELL_OK : (uint64_t)(int64_t)CELL_FS_ENOENT;
+}
+
+static void cellFsTruncate(ppu_context* ctx)
+{
+    char gpath[1024];
+    guest_strcpy(gpath, (uint32_t)ctx->gpr[3], sizeof gpath);
+    uint64_t size = ctx->gpr[4];
+    int r = fs_truncate_guest_path(gpath, size);
+    int err = errno;
+    if (pfs_cache_trace() && fs_is_cache_path(gpath))
+        fprintf(stderr, "[pfscache] truncate '%s' size=0x%llX -> %s lr=0x%08X\n",
+                gpath, (unsigned long long)size, r == 0 ? "OK" : strerror(err),
+                (uint32_t)ctx->lr);
+    ctx->gpr[3] = r == 0 ? CELL_OK : (uint64_t)(int64_t)CELL_FS_ENOENT;
+}
+
+static void cellFsFtruncate(ppu_context* ctx)
+{
+    int fd = (int)(uint32_t)ctx->gpr[3];
+    uint64_t size = ctx->gpr[4];
+    FILE* f = fd_file(fd);
+    if (!f) { ctx->gpr[3] = (uint64_t)(int64_t)CELL_FS_EIO; return; }
+    fflush(f);
+#ifdef _WIN32
+    int rc = _chsize_s(_fileno(f), (long long)size);
+#else
+    int rc = ftruncate(fileno(f), (off_t)size);
+#endif
+    if (pfs_cache_trace() && fd >= 0 && fd < FS_MAX && fs_is_cache_path(g_fd_path[fd]))
+        fprintf(stderr, "[pfscache] ftruncate fd=%d '%s' size=0x%llX -> %s lr=0x%08X\n",
+                fd, g_fd_path[fd], (unsigned long long)size,
+                rc == 0 ? "OK" : "FAIL", (uint32_t)ctx->lr);
+    ctx->gpr[3] = rc == 0 ? CELL_OK : (uint64_t)(int64_t)CELL_FS_EIO;
+}
 
