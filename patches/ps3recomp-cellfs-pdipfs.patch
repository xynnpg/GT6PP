+/* ---- PDIPFS cache diagnostics --------------------------------------------
+ *
+ * GT6's PDIPFS cache lives beside the game data and consists of a data file
+ * ("<key>.fdupi" while it is being built, then "<key>" after completion) and
+ * an 8 KiB+ block map ("<key>.fdupm").  The guest opens both through cellFs.
+ * GT6_PFS_CACHE_TRACE=1 logs every cellFs operation on those paths, including
+ * the guest return address, so "was the block write issued?" can be answered
+ * without a generated-code patch.  Off by default: the normal [fs] logging is
+ * already noisy enough.
+ */
+static int pfs_cache_trace(void)
+{
+    static int on = -1;
+    if (on < 0) {
+        const char* e = getenv("GT6_PFS_CACHE_TRACE");
+        on = (e && *e && *e != '0') ? 1 : 0;
+    }
+    return on;
+}
+
+static int fs_is_cache_path(const char* p)
+{
+    if (!p || !*p) return 0;
+    if (strstr(p, "PDIPFS")) return 1;
+    size_t n = strlen(p);
+    return (n >= 6 && (strcmp(p + n - 6, ".fdupi") == 0 ||
+                       strcmp(p + n - 6, ".fdupm") == 0));
+}
