+/* ---------------------------------------------------------------------------
+ * AU assembly
+ * -----------------------------------------------------------------------*/
+static int dmux_buf_reserve(DmuxEs* es, u32 extra)
+{
+    u32 need = es->asm_len + extra;
+    if (need <= es->asm_cap)
+        return 1;
+    if (need > DMUX_ASM_CAP)
+        return 0;
+    u32 cap = es->asm_cap;
+    while (cap < need)
+        cap *= 2;
+    if (cap > DMUX_ASM_CAP)
+        cap = DMUX_ASM_CAP;
+    u8* p = (u8*)realloc(es->asm_buf, cap);
+    if (!p)
+        return 0;
+    es->asm_buf = p;
+    es->asm_cap = cap;
+    return 1;
+}
+
+static void dmux_mark_add(DmuxEs* es, u64 pos, u64 pts, u64 dts)
+{
+    if (es->mark_count == DMUX_MARK_MAX) {
+        if (es->mark_head) {
+            memmove(es->marks, es->marks + es->mark_head,
+                    (es->mark_count - es->mark_head) * sizeof(es->marks[0]));
+            es->mark_count -= es->mark_head;
+            es->mark_head = 0;
+        }
+        if (es->mark_count == DMUX_MARK_MAX) {
+            memmove(es->marks, es->marks + 1,
+                    (DMUX_MARK_MAX - 1) * sizeof(es->marks[0]));
+            es->mark_count--;
+        }
+    }
+    es->marks[es->mark_count].pos = pos;
+    es->marks[es->mark_count].pts = pts;
+    es->marks[es->mark_count].dts = dts;
+    es->mark_count++;
+}
+
+/* Consume the latest mark at or before `start`.  Returns 1 if one was
+ * found, otherwise the caller synthesizes the next frame timestamp. */
+static int dmux_mark_take(DmuxEs* es, u64 start, u64* pts, u64* dts)
+{
+    int found = 0;
+    u64 p = 0, d = 0;
+    while (es->mark_head < es->mark_count &&
+           es->marks[es->mark_head].pos <= start) {
+        p = es->marks[es->mark_head].pts;
+        d = es->marks[es->mark_head].dts;
+        found = 1;
+        es->mark_head++;
+    }
+    if (es->mark_head > 64 && es->mark_head == es->mark_count) {
+        es->mark_head = es->mark_count = 0;
+    }
+    if (found) {
+        *pts = p;
+        *dts = d;
+    }
+    return found;
+}
+
+static void dmux_drop_front(DmuxEs* es, u32 n)
+{
+    if (n >= es->asm_len) {
+        es->asm_len = 0;
+        es->asm_base += n;
+        return;
+    }
+    memmove(es->asm_buf, es->asm_buf + n, es->asm_len - n);
+    es->asm_len -= n;
+    es->asm_base += n;
+}
+
+static int dmux_is_avc_idr(const u8* p, u32 len)
+{
+    for (u32 i = 0; i + 4 < len; i++) {
+        if (p[i] == 0 && p[i + 1] == 0 && p[i + 2] == 1 &&
+            (p[i + 3] & 0x1F) == 5)
+            return 1;
+    }
+    return 0;
+}
+
+static void dmux_queue_au(DmuxEs* es, const u8* data, u32 len, u64 pts,
+                          u64 dts, int is_rap)
+{
+    if (!len)
+        return;
+    if (len > DMUX_AU_SLOT_SIZE) {
+        printf("[cellDmux] ES %u: AU too large (%u > %u), dropped\n",
+               es->index, len, DMUX_AU_SLOT_SIZE);
+        return;
+    }
+    if (es->q_count >= DMUX_AU_QUEUE ||
+        es->q_bytes + len > DMUX_AU_QUEUE_BYTES) {
+        printf("[cellDmux] ES %u: AU queue full (%u AUs, %u bytes), dropped "
+               "AU pts=%llu size=%u\n",
+               es->index, es->q_count, es->q_bytes,
+               (unsigned long long)pts, len);
+        return;
+    }
+
+    DmuxReadyAu* au = &es->q[(es->q_head + es->q_count) % DMUX_AU_QUEUE];
+    au->data = (u8*)malloc(len);
+    if (!au->data)
+        return;
+    memcpy(au->data, data, len);
+    au->size = len;
+    au->pts = pts;
+    au->dts = dts;
+    au->user_data = es->stream_user_data;
+    au->is_rap = (u8)(is_rap ? 1 : 0);
+    es->q_count++;
+    es->q_bytes += len;
+    es->total_aus++;
