+    vm_write32(info_ea + 0x08, max_size);
+    vm_write8 (info_ea + 0x0C, au->is_rap);
+    vm_write8 (info_ea + 0x0D, 0);
+    vm_write8 (info_ea + 0x0E, 0);
+    vm_write8 (info_ea + 0x0F, 0);
+    vm_write64(info_ea + 0x10, au->user_data);
+    vm_write32(info_ea + 0x18, (u32)(au->pts >> 32));
+    vm_write32(info_ea + 0x1C, (u32)au->pts);
+    vm_write32(info_ea + 0x20, (u32)(au->dts >> 32));
+    vm_write32(info_ea + 0x24, (u32)au->dts);
+    (void)es;
