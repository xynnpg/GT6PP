+    es = dmux_match_es(d, sid, p + payload, len - payload);
+    if (!es)
+        return;
+
+    const u8* data = p + payload;
+    u32 dlen = len - payload;
+    if (sid == 0xBD) {
+        /* PAMF private-stream prefix: one private_stream_id byte plus three
+         * bytes of PAMF framing, then the ATS/AC3/LPCM data. */
+        if (dlen < 4)
+            return;
+        data += 4;
+        dlen -= 4;
+    }
+    dmux_es_feed(es, data, dlen, has_pts, pts, dts, d->user_data);
+}
+
+static void dmux_pack(DmuxSlot* d, const u8* pack)
+{
+    u32 off = 14;
+
+    while (off + 6 <= 0x800) {
+        u8 sid;
+        u32 len, total;
+
+        if (pack[off] != 0 || pack[off + 1] != 0 || pack[off + 2] != 1)
+            break;
+        sid = pack[off + 3];
+        len = be16(pack + off + 4);
+        if (sid == 0xB9)
+            break;
+        total = 6u + len;
+        if (len == 0 || total < 6 || off + total > 0x800)
+            total = 0x800 - off;
+
+        if (sid == 0xBB || sid == 0xBF || sid == 0xBE) {
+            off += total;
+            continue;
+        }
+        if (sid == 0xBD || (sid >= 0xC0 && sid <= 0xEF))
+            dmux_pes(d, pack + off, total, sid);
+        off += total;
+    }
+}
+
+static int dmux_pending_reserve(DmuxSlot* d, u32 extra)
+{
+    u32 need = d->pending_len + extra;
+    if (need <= d->pending_cap)
+        return 1;
+    u32 cap = d->pending_cap ? d->pending_cap : 0x20000;
+    while (cap < need)
+        cap *= 2;
+    u8* p = (u8*)realloc(d->pending, cap);
+    if (!p)
+        return 0;
+    d->pending = p;
+    d->pending_cap = cap;
+    return 1;
+}
+
+static void dmux_process(DmuxSlot* d)
+{
+    u32 off = 0;
+
+    while (d->pending_len - off >= 4) {
+        u8* p = d->pending + off;
+        u32 avail = d->pending_len - off;
+
+        if (!d->started) {
+            if (avail >= 0x54 &&
+                p[0] == 'P' && p[1] == 'A' && p[2] == 'M' && p[3] == 'F') {
+                u32 hs = be32(p + 0x08) * 0x800u;
+                if (!hs)
+                    hs = 0x1000;
+                if (avail < hs)
+                    break;
+                off += hs;
+                d->started = 1;
+                continue;
+            }
+            /* Find the first pack start in whatever the guest handed us. */
+            u32 k;
+            for (k = 0; k + 4 <= avail; k++)
+                if (p[k] == 0 && p[k + 1] == 0 && p[k + 2] == 1 &&
+                    p[k + 3] == 0xBA)
+                    break;
+            if (k + 4 > avail) {
+                if (avail > 3)
+                    off += avail - 3;       /* keep a possible split magic */
+                break;
+            }
+            off += k;
+            d->started = 1;
+            continue;
+        }
+
+        if (avail < 0x800)
+            break;
+        if (p[0] != 0 || p[1] != 0 || p[2] != 1 || p[3] != 0xBA) {
+            d->started = 0;
+            continue;
+        }
+        dmux_pack(d, p);
+        off += 0x800;
+    }
+
+    if (off) {
+        memmove(d->pending, d->pending + off, d->pending_len - off);
+        d->pending_len -= off;
+    }
 }
 
