+static void dmux_au_time(DmuxEs* es, u64 start, u32 frame_ticks,
+                         u64* pts, u64* dts)
+{
+    u64 p = 0, d = 0;
+    if (dmux_mark_take(es, start, &p, &d)) {
+        *pts = p;
+        *dts = d;
+    } else if (es->have_last_pts) {
+        *pts = es->last_pts + frame_ticks;
+        *dts = es->last_dts + frame_ticks;
+    } else {
+        *pts = 0;
+        *dts = 0;
+    }
+    es->last_pts = *pts;
+    es->last_dts = *dts;
+    es->have_last_pts = 1;
