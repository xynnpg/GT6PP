+static const u8* pamf_ep_ptr(PamfHost* h, u32 index)
+{
+    if (!h || h->current >= h->stream_count)
+        return NULL;
+    {
+        const PamfStream* s = &h->streams[h->current];
+        if (index >= s->ep_num)
+            return NULL;
+        if (s->ep_offset + (index + 1) * 12u > h->header_size)
+            return NULL;
+        return h->base + s->ep_offset + index * 12u;
+    }
+}
+
+static void pamf_ep_write(u32 ep_ea, const u8* packed)
+{
+    u16 v0 = be16(packed + 0);
+    vm_write32(ep_ea + 0x00, (u32)(v0 >> 14) + 1);
+    vm_write32(ep_ea + 0x04, ((u32)(v0 & 0x1FFF) * 0x800u) + 0x800u);
+    vm_write32(ep_ea + 0x08, be16(packed + 2));
+    vm_write32(ep_ea + 0x0C, be32(packed + 4));
+    vm_write64(ep_ea + 0x10, (u64)be32(packed + 8) * 0x800ull);
+}
