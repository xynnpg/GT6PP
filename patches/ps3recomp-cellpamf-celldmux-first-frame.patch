+    flags2 = p[7];
+    hlen = p[8];
+    payload = 9u + hlen;
+    if (payload > len)
+        return;
+
+    if ((flags2 & 0x80) && hlen >= 5) {
+        pts = parse_pts(p + 9);
+        dts = pts;
+        has_pts = 1;
+        if ((flags2 & 0xC0) == 0xC0 && hlen >= 10)
+            dts = parse_pts(p + 14);
+    }
