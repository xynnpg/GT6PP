+    if (!it_ea)
+        return (s32)CELL_PAMF_ERROR_INVALID_ARG;
+
+    index = vm_read32(it_ea + 0x4);
+    num   = vm_read32(it_ea + 0x8);
+    pcur  = vm_read32(it_ea + 0xC);
+    if (num == 0)
+        return 0;
+
+    new_index = (s32)index + steps;
+    if (new_index < 0) {
+        steps = -(s32)index;
+        new_index = 0;
+    } else if ((u32)new_index >= num) {
+        steps = (s32)(num - index) - 1;
+        new_index = (s32)index + steps;
+    }
+
+    vm_write32(it_ea + 0x4, (u32)new_index);
+    vm_write32(it_ea + 0xC, (u32)((s32)pcur + steps * 12));
+
+    if (pEp) {
+        s32 rc = cellPamfEpIteratorGetEp(pIt, pEp);
+        if (rc != CELL_OK)
+            return rc;
+    }
+    return steps;
+}
