+        if (es->scan_pos >= es->asm_len)
+            es->scan_pos = 0;
+        u32 k = dmux_find_aud(es->asm_buf, es->asm_len, es->scan_pos);
+        if (k == 0xFFFFFFFFu) {
+            es->scan_pos = (es->asm_len > 3) ? es->asm_len - 3 : es->asm_len;
+            return;
+        }
+        if (k > 0) {
+            dmux_finalize_video(es, k);
+            dmux_drop_front(es, k);
