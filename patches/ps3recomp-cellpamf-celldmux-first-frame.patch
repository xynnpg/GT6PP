+static u32 dmux_find_aud(const u8* p, u32 len, u32 from)
+{
+    for (u32 i = from; i + 3 < len; i++) {
+        if (p[i] == 0 && p[i + 1] == 0 && p[i + 2] == 1 && p[i + 3] == 9) {
