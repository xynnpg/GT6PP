+s32 cellPamfEpIteratorGetEp(CellPamfEpIterator* pIt, CellPamfEp* pEp)
+{
+    u32 it_ea = (u32)(uintptr_t)pIt;
+    u32 ep_ea = (u32)(uintptr_t)pEp;
