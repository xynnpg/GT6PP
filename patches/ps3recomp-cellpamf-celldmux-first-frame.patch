+/* ---------------------------------------------------------------------------
+ * Pack / PES parser
+ * -----------------------------------------------------------------------*/
+static DmuxEs* dmux_match_es(DmuxSlot* d, u8 sid, const u8* payload, u32 plen)
+{
+    DmuxEs* only = NULL;
+    u32 n = 0;
+    u32 di = (u32)(d - s_dmux);
+
+    for (u32 i = 0; i < CELL_DMUX_MAX_ES; i++) {
+        DmuxEs* es = &s_es[i];
+        if (!es->in_use || es->dmux_index != di || es->fmajor != sid)
+            continue;
+        if (sid == 0xBD) {
+            if (!plen)
+                continue;
+            if (es->fminor != payload[0]) {
+                only = es;
+                n++;
+                continue;
+            }
+        }
+        return es;
+    }
+    return (sid == 0xBD && n == 1) ? only : NULL;
+}
+
+static void dmux_pes(DmuxSlot* d, const u8* p, u32 len, u8 sid)
+{
