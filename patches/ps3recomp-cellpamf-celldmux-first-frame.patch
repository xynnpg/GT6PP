+        return 0;
+    u32 ea = VM_HLE_INJECT_BASE + DMUX_FALLBACK_OFF +
+             es_index * DMUX_AU_SLOT_SIZE;
+    if (!(s_fallback_committed & (1u << es_index))) {
+        if (vm_commit(ea, DMUX_AU_SLOT_SIZE) != 0)
+            return 0;
+        s_fallback_committed |= 1u << es_index;
+    }
+    return ea;
