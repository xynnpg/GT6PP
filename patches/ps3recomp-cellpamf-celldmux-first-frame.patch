+               es->index, len);
+        return;
+    }
+    if (has_pts)
+        dmux_mark_add(es, es->asm_base + es->asm_len, pts, dts);
+    memcpy(es->asm_buf + es->asm_len, data, len);
+    es->asm_len += len;
