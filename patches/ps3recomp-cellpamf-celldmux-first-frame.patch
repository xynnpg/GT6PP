+static void dmux_reset_es_stream(DmuxEs* es)
+{
+    for (u32 i = 0; i < es->q_count; i++)
+        free(es->q[(es->q_head + i) % DMUX_AU_QUEUE].data);
+    es->q_head = es->q_count = es->q_bytes = 0;
+    es->asm_len = 0;
+    es->asm_base = 0;
+    es->scan_pos = 0;
+    es->audio_frame_len = 0;
+    es->mark_head = es->mark_count = 0;
+    es->have_last_pts = 0;
+    es->delivered = 0;
+}
+
+s32 cellDmuxSetStream(u32 demuxerHandle, u32 streamAddress, u32 streamSize,
+                      b8 discontinuity, u64 userData)
+{
+    DmuxSlot* d = dmux_slot(demuxerHandle);
+    if (!d)
+        return (s32)CELL_DMUX_ERROR_ARG;
+
+    if (discontinuity)
+        cellDmuxResetStream(demuxerHandle);
+
+    d->user_data = userData;
+
+    while (streamSize) {
+        u32 n = streamSize > 0x100000 ? 0x100000 : streamSize;
+        if (!streamAddress || !dmux_pending_reserve(d, n))
+            return (s32)CELL_DMUX_ERROR_FATAL;
+        memcpy(d->pending + d->pending_len, vm_ptr8(streamAddress), n);
+        d->pending_len += n;
+        streamAddress += n;
+        streamSize -= n;
+        dmux_process(d);
+    }
+
+    dmux_notify(d, demuxerHandle, CELL_DMUX_MSG_TYPE_DEMUX_DONE);
     return CELL_OK;
 }
 
