+
+static void dmux_es_feed(DmuxEs* es, const u8* data, u32 len, int has_pts,
+                         u64 pts, u64 dts, u64 user_data)
+{
+    if (!len)
+        return;
+    es->stream_user_data = user_data;
+    if (!dmux_buf_reserve(es, len)) {
