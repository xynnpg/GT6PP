+             * the very first byte of the stream.  Later 4-byte AUDs are cut
+             * at the 3-byte form; the extra zero stays at the end of the
+             * previous AU, where it is harmless. */
+            if (i == 1 && from == 0 && p[0] == 0)
+                return 0;
+            return i;
+        }
+    }
+    return 0xFFFFFFFFu;
