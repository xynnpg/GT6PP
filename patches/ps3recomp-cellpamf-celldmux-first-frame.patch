+        ep[0] = (u8)(v0 >> 8);
+        ep[1] = (u8)v0;
+        ep[2] = (u8)(hi >> 8);
+        ep[3] = (u8)hi;
+        ep[4] = (u8)(lo >> 24);
+        ep[5] = (u8)(lo >> 16);
+        ep[6] = (u8)(lo >> 8);
+        ep[7] = (u8)lo;
+        ep[8] = (u8)(rpn >> 24);
+        ep[9] = (u8)(rpn >> 16);
+        ep[10] = (u8)(rpn >> 8);
+        ep[11] = (u8)rpn;
+        pamf_ep_write(ep_ea, ep);
+    }
+    return CELL_OK;
