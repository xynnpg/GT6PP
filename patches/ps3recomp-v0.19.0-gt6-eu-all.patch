+          [0x9F9380, 0x9F9380, 0x9F93D0, 0x9F93D0, 0x9F93EC, 0x9F9428,
+           0x9F9444, 0x9F9460, 0x9F947C, 0x9F947C, 0x9F9498, 0x9F9498,
+           0x9F94D0, 0x9F94B4])
